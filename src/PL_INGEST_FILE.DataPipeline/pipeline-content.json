{
  "properties": {
    "activities": [
      {
        "name": "LK_GET_FILE_ENTITIES",
        "type": "Lookup",
        "description": "Every active catalog.LandingEntity behind a FILE-type Connection",
        "dependsOn": [],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": {
              "value": "SELECT le.[LandingEntityId], le.[SourceSchema], le.[SourceObject], le.[SourceQuery], le.[FilePath], le.[FileType], s.[Namespace], c.[ConnectionGuid] FROM [catalog].[LandingEntity] le JOIN [catalog].[Source] s ON le.[SourceId] = s.[SourceId] JOIN [catalog].[Connection] c ON s.[ConnectionId] = c.[ConnectionId] WHERE le.[IsActive] = 1 AND s.[IsActive] = 1 AND c.[IsActive] = 1 AND c.[Type] = 'FILE'",
              "type": "Expression"
            },
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "datasetSettings": {
            "annotations": [],
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "typeProperties": {
              "schema": "catalog",
              "table": "LandingEntity"
            },
            "connectionSettings": {
              "name": "SQL_STRATUM_CATALOG",
              "properties": {
                "annotations": [],
                "type": "FabricSqlDatabase",
                "typeProperties": {
                  "workspaceId": "__INTEGRATION_WORKSPACE_ID__",
                  "artifactId": "__CATALOG_DATABASE_ID__"
                },
                "externalReferences": {
                  "connection": "__CATALOG_CONNECTION_ID__"
                }
              }
            }
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "FE_FILE_ENTITY",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "LK_GET_FILE_ENTITIES",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('LK_GET_FILE_ENTITIES').output.value",
            "type": "Expression"
          },
          "activities": [
            {
              "name": "CP_FILE_TO_LANDING",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.01:00:00",
                "retry": 1,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "typeProperties": {
                "source": {
                  "type": "BinarySource",
                  "storeSettings": {
                    "type": "AzureBlobFSReadSettings",
                    "recursive": true
                  },
                  "datasetSettings": {
                    "annotations": [],
                    "type": "Binary",
                    "typeProperties": {
                      "location": {
                        "type": "AzureBlobFSLocation",
                        "fileSystem": {
                          "value": "@item().Namespace",
                          "type": "Expression"
                        },
                        "folderPath": {
                          "value": "@item().SourceSchema",
                          "type": "Expression"
                        },
                        "fileName": {
                          "value": "@item().SourceObject",
                          "type": "Expression"
                        }
                      }
                    },
                    "externalReferences": {
                      "connection": "@item().ConnectionGuid"
                    }
                  }
                },
                "sink": {
                  "type": "BinarySink",
                  "storeSettings": {
                    "type": "LakehouseWriteSettings",
                    "copyBehavior": "PreserveHierarchy"
                  },
                  "datasetSettings": {
                    "annotations": [],
                    "linkedService": {
                      "name": "LandingLakehouse",
                      "properties": {
                        "annotations": [],
                        "type": "Lakehouse",
                        "typeProperties": {
                          "workspaceId": "__DATA_WORKSPACE_ID__",
                          "artifactId": "__LANDING_LAKEHOUSE_ID__",
                          "rootFolder": "Files"
                        }
                      }
                    },
                    "type": "Binary",
                    "typeProperties": {
                      "location": {
                        "type": "LakehouseLocation",
                        "fileName": {
                          "value": "@item().SourceObject",
                          "type": "Expression"
                        },
                        "folderPath": {
                          "value": "@item().FilePath",
                          "type": "Expression"
                        }
                      }
                    },
                    "schema": []
                  }
                },
                "enableStaging": false
              }
            }
          ]
        }
      }
    ],
    "parameters": {}
  }
}
