{
  "properties": {
    "activities": [
      {
        "name": "LK_GET_SQL_ENTITIES",
        "type": "Lookup",
        "description": "Every active catalog.LandingEntity behind a SQL-type Connection",
        "dependsOn": [],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": {
              "value": "SELECT le.[LandingEntityId], le.[SourceSchema], le.[SourceObject], le.[SourceQuery], le.[FilePath], le.[FileType], s.[Namespace], c.[ConnectionGuid] FROM [catalog].[LandingEntity] le JOIN [catalog].[Source] s ON le.[SourceId] = s.[SourceId] JOIN [catalog].[Connection] c ON s.[ConnectionId] = c.[ConnectionId] WHERE le.[IsActive] = 1 AND s.[IsActive] = 1 AND c.[IsActive] = 1 AND c.[Type] = 'SQL'",
              "type": "Expression"
            },
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "datasetSettings": {
            "annotations": [],
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "typeProperties": {
              "schema": "catalog",
              "table": "LandingEntity"
            },
            "connectionSettings": {
              "name": "SQL_STRATUM_CATALOG",
              "properties": {
                "annotations": [],
                "type": "FabricSqlDatabase",
                "typeProperties": {
                  "workspaceId": "__INTEGRATION_WORKSPACE_ID__",
                  "artifactId": "__CATALOG_DATABASE_ID__"
                },
                "externalReferences": {
                  "connection": "__CATALOG_CONNECTION_ID__"
                }
              }
            }
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "FE_SQL_ENTITY",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "LK_GET_SQL_ENTITIES",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('LK_GET_SQL_ENTITIES').output.value",
            "type": "Expression"
          },
          "activities": [
            {
              "name": "CP_SQL_TO_LANDING",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.01:00:00",
                "retry": 1,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "typeProperties": {
                "source": {
                  "type": "AzureSqlSource",
                  "sqlReaderQuery": {
                    "value": "@if(empty(item().SourceQuery), concat('SELECT * FROM ', item().SourceSchema, '.', item().SourceObject), item().SourceQuery)",
                    "type": "Expression"
                  },
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None",
                  "datasetSettings": {
                    "annotations": [],
                    "type": "AzureSqlTable",
                    "schema": [],
                    "typeProperties": {
                      "schema": {
                        "value": "@item().SourceSchema",
                        "type": "Expression"
                      },
                      "table": {
                        "value": "@item().SourceObject",
                        "type": "Expression"
                      }
                    },
                    "externalReferences": {
                      "connection": "@item().ConnectionGuid"
                    }
                  }
                },
                "sink": {
                  "type": "ParquetSink",
                  "storeSettings": {
                    "type": "LakehouseWriteSettings",
                    "copyBehavior": "PreserveHierarchy"
                  },
                  "formatSettings": {
                    "type": "ParquetWriteSettings"
                  },
                  "datasetSettings": {
                    "annotations": [],
                    "linkedService": {
                      "name": "LandingLakehouse",
                      "properties": {
                        "annotations": [],
                        "type": "Lakehouse",
                        "typeProperties": {
                          "workspaceId": "__DATA_WORKSPACE_ID__",
                          "artifactId": "__LANDING_LAKEHOUSE_ID__",
                          "rootFolder": "Files"
                        }
                      }
                    },
                    "type": "Parquet",
                    "typeProperties": {
                      "location": {
                        "type": "LakehouseLocation",
                        "fileName": {
                          "value": "@concat(item().SourceObject, '.parquet')",
                          "type": "Expression"
                        },
                        "folderPath": {
                          "value": "@item().FilePath",
                          "type": "Expression"
                        }
                      },
                      "compressionCodec": "snappy"
                    },
                    "schema": []
                  }
                },
                "enableStaging": false,
                "validateDataConsistency": false,
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {
                    "allowDataTruncation": true,
                    "treatBooleanAsNumber": false
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "parameters": {}
  }
}
